+  var slot := housing.grow(-2)
+  draw_style_box(make_box(light.darkened(0.48), light.darkened(0.48), 0, 1), slot)
+  draw_style_box(make_box(light, light, 0, 1), slot.grow(-0.7))
+  draw_line(Vector2(4, 2.8), Vector2(size.x - 4, 2.8), light.lightened(0.28), 0.5, true)
+
+ func make_box(fill: Color, edge: Color, rim: int, radius: int) -> StyleBoxFlat:
+  var box := StyleBoxFlat.new()
+  box.bg_color = fill
+  box.border_color = edge
+  box.set_border_width_all(rim)
+  box.set_corner_radius_all(radius)
+  return box
+
